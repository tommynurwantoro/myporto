# Copy to .env and fill in values before deploying:
#   cp .env.example .env
#
# Production with Traefik:
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d --build
#
# Local without Traefik:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build

# --- Domain & Traefik (production overlay) ---
DOMAIN=tommynurwantoro.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Frontend (embedded at Docker build time) ---
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Relative /api — browser hits nginx, nginx proxies to internal API
VITE_API_BASE_URL=/api
VITE_VERIFY_BASE_URL=https://tommynurwantoro.com

# --- API (required at runtime) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=generate-a-long-random-secret
ALLOWED_SIGNER_EMAILS=tommy.nurwantoro@gmail.com
CORS_ORIGIN=https://tommynurwantoro.com
VERIFY_BASE_URL=https://tommynurwantoro.com

# --- Database ---
# Default compose stack uses bundled Postgres (leave unset or use this):
# DATABASE_URL=postgres://myporto:myporto@postgres:5432/myporto?sslmode=disable
# External Postgres (production):
# DATABASE_URL=postgres://user:pass@host:5432/myporto?sslmode=disable
